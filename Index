            /* background-size: cover; */
            /* background-position: center; */
        }

        /* Barra de Informações (Nome e Botões) */
        .card-info-bar {
            background-color: #4a1225; /* Fundo mais escuro para a barra */
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap; /* Permite quebrar linha no celular */
            gap: 20px;
        }

        /* Títulos */
        .title-group h1 {
            font-family: 'Oswald', sans-serif;
            font-size: 2.2rem;
            text-transform: uppercase;
            letter-spacing: -1px;
            line-height: 1;
            margin-bottom: 5px;
        }

        .title-group p {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.7);
            letter-spacing: 1px;
        }

        /* Botões */
        .buttons-group {
            display: flex;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 50px;
            text-decoration: none;
            color: #fff;
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: transform 0.2s ease, background-color 0.2s ease;
            
            /* Estilo do gradiente/transparência original */
            background-color: rgba(33, 184, 157, 0.459);
            background-image: linear-gradient(45deg, rgba(37, 176, 176, 0.42) 0%, rgba(33, 184, 157, 0.004) 100%);
            border: none;
        }

        .btn:hover {
            transform: scale(1.05);
            background-color: rgba(33, 184, 166, 0.82);
        }

        .btn svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        /* Área de Texto/Preços (Rodapé) */
        .card-content {
            background-color: #5c1a2e;
            padding: 25px 30px 35px 30px;
        }

        .card-content p {
            font-size: 1.1rem;
            line-height: 1.4;
            color: #fff;
        }
        
        .card-content .subtitle {
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 5px;
        }

        /* Responsividade para Celulares */
        @media (max-width: 600px) {
            .card-header-image {
                height: 180px;
            }

            .card-info-bar {
                flex-direction: column;
                align-items: flex-start;
                padding: 20px;
            }

            .title-group h1 {
                font-size: 1.8rem;
            }

            .buttons-group {
                width: 100%;
            }

            .btn {
                flex: 1; /* Botões ocupam largura igual */
                padding: 10px;
            }

            .card-content {
                padding: 20px;
            }

            .card-content p {
                font-size: 1rem;
            }
        }
    </style>
</head>
